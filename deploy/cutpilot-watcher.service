[Unit]
Description=CutPilot FFmpeg folder watcher
After=network.target smbd.service

[Service]
Type=simple
User=cutpilot
Group=cutpilot
RuntimeDirectory=cutpilot
RuntimeDirectoryMode=0770
Environment=CUTPILOT_LOGO_H=/srv/logo/logo.png
Environment=CUTPILOT_LOGO_V=/srv/logo/logo_v.png
Environment=CUTPILOT_LOG_FILE=/var/lib/cutpilot/watcher.log
Environment=HOME=/var/lib/cutpilot
Environment=XDG_CACHE_HOME=/var/lib/cutpilot/cache
Environment=CUDA_CACHE_PATH=/var/lib/cutpilot/cache/nv
Environment=CUTPILOT_PROGRESS_DIR=/var/lib/cutpilot/progress
Environment=CUTPILOT_JOB_MANIFEST_DIR=/var/lib/cutpilot/jobs
Environment=CUTPILOT_API_QUEUE_DIR=/var/lib/cutpilot/queue
Environment=CUTPILOT_WORKER_MODE=nvenc
Environment=CUTPILOT_AUTO_TAIL_CUT=1
ExecStart=/usr/local/sbin/cutpilot-watcher
Restart=always
RestartSec=3
NoNewPrivileges=true
ProtectHome=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
ReadWritePaths=/srv/cutpilot /var/lib/cutpilot /var/lib/cutpilot/queue /run/cutpilot
RestrictAddressFamilies=AF_UNIX

[Install]
WantedBy=multi-user.target
