#!/usr/bin/env bash
# CutPilot folder watcher. Command block examples: [cmd -mp4 -1080p] or [cmd-mp4-1080p]
set -u
shopt -s nocasematch

WATCH_DIR=/srv/cutpilot
LOGO_H=${CUTPILOT_LOGO_H:-/srv/logo/logo.png}
LOGO_V=${CUTPILOT_LOGO_V:-/srv/logo/logo_v.png}
LOG_FILE=/var/log/cutpilot-watcher.log
RUN_DIR=/run/cutpilot
STABLE_DIR=$RUN_DIR/stable
LOCK_DIR=$RUN_DIR/locks
STABLE_DELAY=${CUTPILOT_STABLE_DELAY:-10}
WORKER_MODE=${CUTPILOT_WORKER_MODE:-nvenc}

mkdir -p "$WATCH_DIR" "$RUN_DIR" "$STABLE_DIR" "$LOCK_DIR"
# Locks are empty directories. A service restart can interrupt a worker before its
# RETURN trap runs, so clear locks inherited from a previous watcher instance.
find "$LOCK_DIR" -mindepth 1 -maxdepth 1 -type d -empty -exec rmdir {} + 2>/dev/null || true
touch "$LOG_FILE"
log(){ printf '%s %s\n' "$(date -Is)" "$*" >> "$LOG_FILE"; }
valid_video(){ local ext=${1##*.}; case "${ext,,}" in mp4|mkv|mov|avi|m4v|webm|ts|m2ts|mts) return 0;; *) return 1;; esac; }
processable_file(){
  local name base
  name=$(basename "$1"); base=${name%.*}
  valid_video "$name" || return 1
  [[ "$base" == *_logo* || "$base" == *_nologo* || "$base" == *.tmp.* || "$name" == *.error.txt ]] && return 1
  return 0
}
state_file(){ printf '%s/%s' "$STABLE_DIR" "$(printf '%s' "$1" | sha256sum | awk '{print $1}')"; }

probe_video(){
  SRC_WIDTH=$(ffprobe -v error -select_streams v:0 -show_entries stream=width -of default=nw=1:nk=1 "$1" 2>/dev/null | head -1)
  SRC_HEIGHT=$(ffprobe -v error -select_streams v:0 -show_entries stream=height -of default=nw=1:nk=1 "$1" 2>/dev/null | head -1)
  SRC_DURATION=$(ffprobe -v error -show_entries format=duration -of default=nw=1:nk=1 "$1" 2>/dev/null | head -1)
  SRC_BITRATE=$(ffprobe -v error -select_streams v:0 -show_entries stream=bit_rate -of default=nw=1:nk=1 "$1" 2>/dev/null | head -1)
  SRC_AUDIO_BITRATE=$(ffprobe -v error -select_streams a:0 -show_entries stream=bit_rate -of default=nw=1:nk=1 "$1" 2>/dev/null | head -1)
  HAS_AUDIO=0
  ffprobe -v error -select_streams a:0 -show_entries stream=codec_type -of default=nw=1:nk=1 "$1" 2>/dev/null | grep -qx audio && HAS_AUDIO=1
  [[ "$SRC_WIDTH" =~ ^[0-9]+$ && "$SRC_HEIGHT" =~ ^[0-9]+$ && "$SRC_DURATION" =~ ^[0-9.]+$ ]] || return 1
  [[ "$SRC_BITRATE" =~ ^[0-9]+$ ]] || SRC_BITRATE=0
  [[ "$SRC_AUDIO_BITRATE" =~ ^[0-9]+$ ]] || SRC_AUDIO_BITRATE=192000
}

reset_options(){
  OUT_CONTAINER=""; VIDEO_CODEC=h264; TARGET_HEIGHT=0; TARGET_FPS=0; TARGET_BYTES=0
  NO_LOGO=0; NO_CUT=0; CMD_ERROR=""; COMMAND_USED=0
  EDIT_MODE=none; EDIT_STARTS=(); EDIT_ENDS=()
}

time_to_seconds(){
  local value=$1 a b c
  IFS=. read -r a b c <<< "$value"
  if [[ -n "$c" ]]; then TIME_SECONDS=$((10#$a*3600 + 10#$b*60 + 10#$c)); else TIME_SECONDS=$((10#$a*60 + 10#$b)); fi
}

parse_edit_command(){
  local kind=$1 prefix_len=$2 start end rest
  compact=${compact:prefix_len}
  EDIT_MODE=$kind
  while :; do
    if [[ "$compact" =~ ^([0-9]{1,2}\.[0-5][0-9](\.[0-5][0-9])?)-([0-9]{1,2}\.[0-5][0-9](\.[0-5][0-9])?)(.*)$ ]]; then
      start=${BASH_REMATCH[1]}; end=${BASH_REMATCH[3]}; rest=${BASH_REMATCH[5]}
      time_to_seconds "$start"; EDIT_STARTS+=("$TIME_SECONDS")
      time_to_seconds "$end"; EDIT_ENDS+=("$TIME_SECONDS")
      (( TIME_SECONDS > EDIT_STARTS[${#EDIT_STARTS[@]}-1] )) || { CMD_ERROR="Each edit range must have an end after its start"; return 1; }
    else
      CMD_ERROR="Invalid edit range; use 4.15-4.36 or 1.23.23-1.24.10"
      return 1
    fi
    if [[ "$rest" == +* ]]; then
      [[ "$kind" != keep ]] || { CMD_ERROR="crp keeps one range; use crp+ to concatenate several"; return 1; }
      compact=${rest:1}
    else
      compact=$rest
      return 0
    fi
  done
}

# Removes optional spaces and parses commands left-to-right. No shell evaluation is ever used.
parse_commands(){
  local base=$1 raw compact number unit
  reset_options
  if [[ "$base" =~ ^(.*)\[cmd([[:space:]-].*)\]$ ]]; then
    CLEAN_STEM=${BASH_REMATCH[1]}
    CLEAN_STEM="${CLEAN_STEM%${CLEAN_STEM##*[![:space:]]}}"
    raw=${BASH_REMATCH[2]}
    compact=${raw//[[:space:]]/}
    COMMAND_USED=1
  else
    CLEAN_STEM=$base
    return 0
  fi
  while [[ -n "$compact" ]]; do
    if [[ "$compact" == -crp+* ]]; then parse_edit_command concat 5 || return 1
    elif [[ "$compact" == -crp-* ]]; then parse_edit_command remove 5 || return 1
    elif [[ "$compact" == -crp=* ]]; then parse_edit_command keep 5 || return 1
    elif [[ "$compact" == crp+* ]]; then parse_edit_command concat 4 || return 1
    elif [[ "$compact" == crp-* ]]; then parse_edit_command remove 4 || return 1
    elif [[ "$compact" == crp[0-9]* ]]; then parse_edit_command keep 3 || return 1
    elif [[ "$compact" == -nologo* ]]; then NO_LOGO=1; compact=${compact:7}
    elif [[ "$compact" == -nl* ]]; then NO_LOGO=1; compact=${compact:3}
    elif [[ "$compact" == -nocut* ]]; then NO_CUT=1; compact=${compact:6}
    elif [[ "$compact" == -nc* ]]; then NO_CUT=1; compact=${compact:3}
    elif [[ "$compact" == -hevc* ]]; then VIDEO_CODEC=hevc; compact=${compact:5}
    elif [[ "$compact" == -mp4* ]]; then
      [[ -z "$OUT_CONTAINER" || "$OUT_CONTAINER" == mp4 ]] || { CMD_ERROR="Only one output container is allowed"; return 1; }
      OUT_CONTAINER=mp4; compact=${compact:4}
    elif [[ "$compact" == -mov* ]]; then
      [[ -z "$OUT_CONTAINER" || "$OUT_CONTAINER" == mov ]] || { CMD_ERROR="Only one output container is allowed"; return 1; }
      OUT_CONTAINER=mov; compact=${compact:4}
    elif [[ "$compact" =~ ^-([0-9]{3,4})p(.*)$ ]]; then
      number=${BASH_REMATCH[1]}; compact=${BASH_REMATCH[2]}
      case "$number" in 1080|720|480|360) TARGET_HEIGHT=$number;; *) CMD_ERROR="Unsupported resolution: ${number}p"; return 1;; esac
    elif [[ "$compact" =~ ^-([0-9]{1,2})fps(.*)$ ]]; then
      number=${BASH_REMATCH[1]}; compact=${BASH_REMATCH[2]}
      if (( number >= 1 && number <= 60 )); then TARGET_FPS=$number; else CMD_ERROR="FPS must be 1-60"; return 1; fi
    elif [[ "$compact" =~ ^-([0-9]+)(gb|mb)(.*)$ ]]; then
      number=${BASH_REMATCH[1]}; unit=${BASH_REMATCH[2]}; compact=${BASH_REMATCH[3]}
      if (( number < 1 )); then CMD_ERROR="Target size must be greater than zero"; return 1; fi
      if [[ "$unit" == gb ]]; then TARGET_BYTES=$((number * 1000 * 1000 * 1000)); else TARGET_BYTES=$((number * 1000 * 1000)); fi
    else CMD_ERROR="Unknown command near: $compact"; return 1
    fi
  done
  if [[ "$VIDEO_CODEC" == hevc && -z "$OUT_CONTAINER" ]]; then OUT_CONTAINER=mp4; fi
}

write_error(){
  local error_file="${1%.*}.error.txt"
  [[ -f "$error_file" && $(<"$error_file") == "$2" ]] && return 0
  printf '%s\n' "$2" > "$error_file"
  log "ERROR $(basename "$1"): $2"
}

validate_audio(){
  ffprobe -v error -select_streams a:0 -show_entries stream=codec_type -of default=nw=1:nk=1 "$1" 2>/dev/null | grep -qx audio || return 0
  ffmpeg -hide_banner -v error -xerror -i "$1" -map '0:a?' -vn -sn -dn -f null - >/dev/null 2>&1
}

validate_output(){
  ffprobe -v error -show_entries format=duration,size -of default=nw=1:nk=1 "$1" >/dev/null 2>&1 || return 1
  validate_audio "$1"
}

detect_tail_trim(){
  local input=$1 duration trace start end seek window
  TAIL_TRIM=""
  (( NO_CUT )) && return 0
  ffprobe -v error -select_streams a:0 -show_entries stream=codec_type -of default=nw=1:nk=1 "$input" 2>/dev/null | grep -qx audio || return 0
  duration=$(ffprobe -v error -show_entries format=duration -of default=nw=1:nk=1 "$input" 2>/dev/null) || return 0
  # Only inspect the tail. A full audio decode pass is needlessly expensive
  # for long recordings when the decision concerns the final silence only.
  seek=$(awk -v d="$duration" 'BEGIN { v=d-60; if(v<0)v=0; printf "%.3f", v }')
  window=$(awk -v d="$duration" -v s="$seek" 'BEGIN { printf "%.3f", d-s }')
  trace=$(ffmpeg -hide_banner -nostdin -nostats -ss "$seek" -i "$input" -t "$window" -map 0:a:0 -af silencedetect=noise=-20dB:d=2 -f null - 2>&1 || true)
  start=$(sed -n 's/.*silence_start: \([0-9.]*\).*/\1/p' <<<"$trace" | tail -1)
  end=$(sed -n 's/.*silence_end: \([0-9.]*\).*/\1/p' <<<"$trace" | tail -1)
  [[ "$start" =~ ^[0-9.]+$ && "$end" =~ ^[0-9.]+$ ]] || return 0
  start=$(awk -v s="$start" -v o="$seek" 'BEGIN { printf "%.3f", s+o }')
  end=$(awk -v e="$end" -v o="$seek" 'BEGIN { printf "%.3f", e+o }')
  awk -v s="$start" -v e="$end" -v d="$duration" 'BEGIN { exit !(d-s>2 && d-e<0.25) }' || return 0
  TAIL_TRIM=$(awk -v s="$start" 'BEGIN { printf "%.3f", s+1 }')
}

trim_encoded_tail(){
  local input=$1 trimmed="${input}.tail.$$"
  [[ -n "$TAIL_TRIM" ]] || return 0
  ffmpeg -hide_banner -loglevel error -xerror -y -i "$input" -t "$TAIL_TRIM" -map 0 -c copy "$trimmed" && mv -f "$trimmed" "$input" || { rm -f "$trimmed"; return 1; }
}

target_bitrate(){
  local duration=$1 audio=128000 usable
  (( TARGET_BYTES > 0 )) || { echo 0; return; }
  usable=$(awk -v b="$TARGET_BYTES" -v d="$duration" -v a="$audio" 'BEGIN { v=int((b*0.965*8/d)-a); if(v<250000)v=250000; print v }')
  echo "$usable"
}

prepare_edit(){
  local i cursor=0 start end
  CLIP_STARTS=(); CLIP_ENDS=()
  [[ "$EDIT_MODE" != none ]] || return 0
  for ((i=0; i<${#EDIT_STARTS[@]}; i++)); do
    start=${EDIT_STARTS[i]}; end=${EDIT_ENDS[i]}
    awk -v e="$end" -v d="$SRC_DURATION" 'BEGIN { exit !(e<=d) }' || { CMD_ERROR="Edit range is outside the video duration"; return 1; }
    if [[ "$EDIT_MODE" == remove ]]; then
      (( start >= cursor )) || { CMD_ERROR="Removed ranges must be in chronological order and cannot overlap"; return 1; }
      (( start > cursor )) && { CLIP_STARTS+=("$cursor"); CLIP_ENDS+=("$start"); }
      cursor=$end
    else
      CLIP_STARTS+=("$start"); CLIP_ENDS+=("$end")
    fi
  done
  if [[ "$EDIT_MODE" == remove ]] && awk -v d="$SRC_DURATION" -v c="$cursor" 'BEGIN { exit !(d>c) }'; then CLIP_STARTS+=("$cursor"); CLIP_ENDS+=("$SRC_DURATION"); fi
  ((${#CLIP_STARTS[@]})) || { CMD_ERROR="Edit would remove the whole video"; return 1; }
}

build_filter(){
  local mode=$1 chain="" final_format source='[0:v]' i inputs=''
  if [[ "$mode" == vaapi ]]; then final_format='format=nv12,hwupload[v]'; else final_format='format=yuv420p[v]'; fi
  AUDIO_MAP='0:a?'; AUDIO_REENCODE=0
  if [[ "$EDIT_MODE" != none ]]; then
    for ((i=0; i<${#CLIP_STARTS[@]}; i++)); do
      chain+="[0:v]trim=start=${CLIP_STARTS[i]}:end=${CLIP_ENDS[i]},setpts=PTS-STARTPTS[cv$i];"
      inputs+="[cv$i]"
      if (( HAS_AUDIO )); then chain+="[0:a]atrim=start=${CLIP_STARTS[i]}:end=${CLIP_ENDS[i]},asetpts=PTS-STARTPTS[ca$i];"; inputs+="[ca$i]"; fi
    done
    if (( HAS_AUDIO )); then chain+="${inputs}concat=n=${#CLIP_STARTS[@]}:v=1:a=1[editv][edita];"; AUDIO_MAP='[edita]'; AUDIO_REENCODE=1
    else chain+="${inputs}concat=n=${#CLIP_STARTS[@]}:v=1:a=0[editv];"
    fi
    source='[editv]'
  fi
  if (( NO_LOGO )); then chain+="${source}null"
  else
    if (( SRC_HEIGHT > SRC_WIDTH )); then ACTIVE_LOGO=$LOGO_V; else ACTIVE_LOGO=$LOGO_H; fi
    [[ -f "$ACTIVE_LOGO" ]] || return 1
    # Logo files are transparent layout templates, not small badges. Scale
    # them to the source axis and overlay at 0:0 to retain their designed
    # internal placement at every output resolution.
    chain+='[1:v]format=rgba,scale='"${SRC_WIDTH}"':-2,colorchannelmixer=aa=0.90[logo];'
    chain+="$source[logo]overlay=0:0:format=auto"
  fi
  (( TARGET_HEIGHT > 0 )) && chain+=",scale=-2:${TARGET_HEIGHT}"
  chain+=",${final_format}"
  FILTER="$chain"
}

encode(){
  local mode=$1 input=$2 output=$3 bitrate codec profile
  bitrate=$(target_bitrate "${TAIL_TRIM:-$SRC_DURATION}")
  [[ "$VIDEO_CODEC" == hevc ]] && { codec=hevc; profile=main; level=5.1; } || { codec=h264; profile=high; level=5.1; }
  # The worker loop owns stdin (it feeds find output to read). Prevent FFmpeg
  # from interpreting that stream as its interactive command console.
  local -a common=(-nostdin -hide_banner -loglevel error -xerror -y -i "$input")
  (( NO_LOGO )) || common+=(-i "$ACTIVE_LOGO")
  [[ -n "$TAIL_TRIM" ]] && common+=(-t "$TAIL_TRIM")
  common+=(-filter_complex "$FILTER" -map '[v]')
  [[ -n "$AUDIO_MAP" ]] && common+=(-map "$AUDIO_MAP")
  common+=(-map_metadata 0 -map_chapters 0)
  (( TARGET_FPS > 0 )) && common+=(-r "$TARGET_FPS") || common+=(-fps_mode passthrough)
  if (( TARGET_BYTES > 0 )); then common+=(-c:a aac -b:a 128k)
  elif (( AUDIO_REENCODE )); then common+=(-c:a aac -b:a "$SRC_AUDIO_BITRATE")
  else common+=(-c:a copy); fi
  if [[ "$mode" == nvenc ]]; then
    # Let NVENC select a valid level. 4K/50fps exceeds H.264 Level 5.1 and
    # requires Level 5.2, while ordinary inputs still resolve to Level 5.1.
    [[ "$codec" == hevc ]] && common+=(-c:v hevc_nvenc -profile:v main) || common+=(-c:v h264_nvenc -profile:v high)
    # multipass fullres can hang indefinitely with the NVENC/driver combination
    # used on the LXC. Keep the quality controls, but use a single stable pass.
    common+=(-preset p4 -tune hq -spatial_aq 1 -temporal_aq 1 -aq-strength 8)
    if (( bitrate > 0 )); then
      common+=(-rc:v vbr -b:v "$bitrate" -maxrate:v "$bitrate" -bufsize:v "$((bitrate*2))")
    elif (( SRC_BITRATE > 0 )); then
      common+=(-rc:v vbr -b:v "$SRC_BITRATE" -maxrate:v "$((SRC_BITRATE*125/100))" -bufsize:v "$((SRC_BITRATE*2))")
    else
      common+=(-rc:v vbr -cq:v 22 -b:v 0)
    fi
    ffmpeg "${common[@]}" "$output"
  else
    [[ "$codec" == hevc ]] && common+=(-c:v hevc_vaapi -profile:v main -level:v 5.1) || common+=(-c:v h264_vaapi -profile:v high -level:v 5.1)
    if (( bitrate > 0 )); then
      common+=(-rc_mode CBR -b:v "$bitrate")
    elif (( SRC_BITRATE > 0 )); then
      common+=(-rc_mode CBR -b:v "$SRC_BITRATE")
    else
      common+=(-rc_mode CQP -qp 23)
    fi
    ffmpeg -vaapi_device /dev/dri/renderD128 "${common[@]}" "$output"
  fi
}

process_file(){
  local input=$1 mode=$2 name ext base out_ext output tmp lock
  name=$(basename "$input"); ext=${name##*.}; base=${name%.*}
  processable_file "$input" || return 0
  lock="$LOCK_DIR/$name.lock"; mkdir "$lock" 2>/dev/null || return 0
  trap 'rmdir "$lock" 2>/dev/null || true' RETURN
  parse_commands "$base" || { write_error "$input" "$CMD_ERROR"; return 0; }
  probe_video "$input" || { write_error "$input" "Cannot read video parameters"; return 0; }
  validate_audio "$input" || { write_error "$input" "Input audio is invalid or the file is still being copied"; return 0; }
  prepare_edit || { write_error "$input" "$CMD_ERROR"; return 0; }
  [[ -n "$OUT_CONTAINER" ]] && out_ext=$OUT_CONTAINER || out_ext=${ext,,}
  (( NO_LOGO )) && output="$WATCH_DIR/${CLEAN_STEM}_nologo.$out_ext" || output="$WATCH_DIR/${CLEAN_STEM}_logo.$out_ext"
  [[ "$output" == "$input" ]] && { write_error "$input" "Output name matches source name"; return 0; }
  if [[ "$EDIT_MODE" == none ]]; then detect_tail_trim "$input"; else TAIL_TRIM=""; fi
  build_filter "$mode" || { write_error "$input" "Logo file is missing"; return 0; }
  tmp="$output.tmp.$$.$RANDOM.$out_ext"
  log "Processing[$mode]: $name -> $(basename "$output")"
  if ! encode "$mode" "$input" "$tmp"; then
    rm -f "$tmp"; write_error "$input" "Encoding failed; source retained for retry"; return 1
  fi
  if ! validate_output "$tmp"; then
    rm -f "$tmp"; write_error "$input" "Output validation failed; source retained for retry"; return 1
  fi
  mv -f "$tmp" "$output" && rm -f "$input" "${input%.*}.error.txt" "$(state_file "$input")" && log "Created: $(basename "$output"); removed original: $name"
}

stable_enough(){
  local f=$1 key signature now record first_seen
  key=$(printf '%s' "$f" | sha256sum | awk '{print $1}')
  signature=$(stat -c '%s:%Y:%Z' "$f" 2>/dev/null) || return 1
  [[ ${signature%%:*} -gt 0 ]] || return 1
  now=$(date +%s)
  record=$(cat "$STABLE_DIR/$key" 2>/dev/null || true)
  if [[ "$record" != "$signature"'|'* ]]; then
    printf '%s|%s' "$signature" "$now" > "$STABLE_DIR/$key"
    return 1
  fi
  first_seen=${record##*|}
  (( now - first_seen >= STABLE_DELAY ))
}

worker(){
  local mode=$1 f
  while :; do
    while IFS= read -r -d '' f; do processable_file "$f" && stable_enough "$f" && process_file "$f" "$mode" || true; done < <(find "$WATCH_DIR" -maxdepth 1 -type f -print0)
    sleep 3
  done
}

log "Started v2; worker=$WORKER_MODE"
worker "$WORKER_MODE"
