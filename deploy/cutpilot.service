[Unit]
Description=CutPilot local AI Cut interface
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=cutpilot
Group=cutpilot
WorkingDirectory=/opt/cutpilot
EnvironmentFile=/etc/cutpilot/cutpilot.env
Environment=CUTPILOT_DB_PATH=/var/lib/cutpilot/cutpilot.db
Environment=CUTPILOT_PROGRESS_DIR=/var/lib/cutpilot/progress
ExecStart=/usr/bin/python3 -m app.server
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/srv/cutpilot /srv/cutpilot/AI_Cut /var/lib/cutpilot
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
