# Copy this file to /etc/cutpilot/cutpilot.env on the LXC.
# Never commit the real key.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_ENDPOINT=https://openrouter.ai/api/v1/chat/completions
CUTPILOT_BIND_ADDRESS=127.0.0.1
CUTPILOT_HOST=127.0.0.1
CUTPILOT_PORT=8787
CUTPILOT_AI_CUT_DIRECTORY=/srv/cutpilot/AI_Cut
CUTPILOT_DIRECTORY=/srv/cutpilot
CUTPILOT_JOB_MANIFEST_DIR=/var/lib/cutpilot/jobs
